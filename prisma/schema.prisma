generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id
  name        String
  number      String
  assignments Assignment[]
}

model Resource {
  id             String          @id
  name           String
  type           String
  team           String          @default("")
  notes          String          @default("")
  assignments    Assignment[]
  resourceSkills ResourceSkill[]
}

model Skill {
  id             String          @id
  name           String
  category       String
  resourceSkills ResourceSkill[]
}

model ResourceSkill {
  id         String   @id
  resourceId String
  skillId    String
  level      String
  notes      String   @default("")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([skillId])
}

model Assignment {
  id         String   @id
  projectId  String
  resourceId String
  start      String
  end        String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([projectId])
  @@index([resourceId])
}

model Task {
  id           String     @id
  assignmentId String
  title        String
  status       String
  start        String
  end          String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model ChangeLogEntry {
  id         String @id
  entityType String
  entityId   String
  field      String
  oldValue   String
  newValue   String
  at         String

  @@index([entityType, entityId])
}

/** Singleton UI preferences row (id always "default"). */
model UiState {
  id                 String @id @default("default")
  filterProjectId    String @default("")
  filterResourceId   String @default("")
  filterResourceType String @default("")
  filterResourceTeam String @default("")
  sortKey            String @default("projectName")
  sortDir            String @default("asc")
  ganttScale         String @default("month")
  stakeholderRole    String @default("manager")
  actingAsResourceId String @default("")
}
